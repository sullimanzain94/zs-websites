# Prime Lane Motors Backend - Environment Configuration
# Copy this file to .env and fill in actual values

# Server
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=plm_production
DB_USER=plm_admin
DB_PASSWORD=change_this_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_this
REFRESH_TOKEN_EXPIRY=30d

# Email Configuration
EMAIL_SERVICE=gmail
EMAIL_FROM=primelanemotors2@gmail.com
EMAIL_USER=primelanemotors2@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_ADMIN=admin@primelanemotors.com

# Frontend URLs
FRONTEND_URL=http://localhost:5173
FRONTEND_URL_PROD=https://primelanemotors.com

# Logging
LOG_LEVEL=info

# Security
CORS_ORIGIN=http://localhost:5173,http://localhost:8080
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Integrations (Placeholder for future)
WHATSAPP_API_KEY=
FINANCE_PROVIDER_API_KEY=
CRM_API_KEY=
