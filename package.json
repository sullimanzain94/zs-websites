{
  "name": "prime-lane-motors",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run build:css -- --watch\" \"vite\"",
    "build": "npm run build:css && vite build",
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/tailwind.css --minify"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "tailwindcss": "^3.4.17",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "build": "^0.1.4",
    "npm": "^12.0.2",
    "run": "^2.1.3"
  },
  "vite": {
    "config": {
      "nativeIgnoreWarning": "true"
    }
  }
}
